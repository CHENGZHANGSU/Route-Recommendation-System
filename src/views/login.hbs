<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compitable" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;600&display=swap">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
    <link rel="icon" type="image/x-icon" href="geek.ico">
    <title>Login</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }
        body{
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background: url('/Mode2.jpg') no-repeat;
            background-size: cover;
            background-position: center;
        }
        /* button {
        width: 150px;
        font-size: 20px;
        padding: 5px;
        border-radius: 10px;
        color: black;
        cursor: pointer;
        margin: 20px;
        } */
        #container{
            position: fixed;
            top: 54%;
            right: 65%;;
        }
        #container2{
            position: fixed;
            top: 54%;
            right: 53%;
        }    
        .dontainer{
            max-width: 700px;
            padding: 0 15px;
            margin: auto;
        }
        .wrapper .field-holder{
            position: relative;
            margin-bottom: 1.25em;
        }
        .field-holder input{
            width: 100%;
        }
        input{
            border: 0;
            border-bottom: 3px solid #dfdfdf;
            outline: none;
            background: transparent;
            color: #dfdfdf;
        }
        label{
            position: absolute;
            top: 0;
            left: 0;
            font-size: 1em;
            color: #ffffff;
            display: flex;
            align-items: center;
            cursor: text;
            transition: 0.2s ease-in-out;
        }
        input,label{
            font-size: 1em;
            width: 60%;
            height: 55px;
            background: transparent;
        }
        input:focus + label,
        input:valid + label{
            color: #424242;
            font-size: .75em;
            top: -25px;
            pointer-events: none;
        }
        input:focus
        input:valid{
            border-bottom: 3px solid #424242;
        }
        .wrapper{
            width: 500px;
            background: transparent;
            color: #ffffff;
            border-radius: 10px;
            padding: 30px 40px;
            border: 2px solid rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(20px);
        }   
        .wrapper h1{
            font-size: 36px;
            text-align: center;
        }
        .wrapper .btn{
            width: 100%;
            height: 45px;
            background: #ffffff;
            border: none;
            outline: none;
            border-radius: 40px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
        }
        .wrapper .register-link{
            font-size: 14.5px;
            text-align: center;
            margin: 20px 0 15px;
        }
        .register-link p a {
            color: #ffffff;
            text-decoration: none;
            font-weight: 60 ;
        }
        .register-link p a:hover{
            text-decoration: underline;
        }

    </style>
</head>
<body>

    <div class="wrapper">
        <div class="dontainer">
            <h1>Login</h1>
            <form action="/auth/login" method="POST">
                <div class="field-holder">
                    <input type="text" id ="account" name="account" required>
                    <label for="account">Account</label>
                 </div>

                <div class="field-holder">
                    <input type="password" id="password" name="password" required>
                    <label for="password">Password</label>
                </div>
                
                <form>
                    <button type= "submit" class="btn">Login</button>
                </form>
                <div class="register-link">
                    <p>Don't have an account? <a href="/register">Register</a></p>
                </div>
            </form>
        </div>
        {{#if message}}
            <h4 class="alert alert-succes">{{message}}</h4>
        {{/if}}
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js" integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy" crossorigin="anonymous"></script>

</body>
</html>