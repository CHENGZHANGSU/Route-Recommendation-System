<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="initial-scale=1.0, user-scalable=no, width=device-width">
    <title>Check Your Traffic Condition</title>
    <link rel="stylesheet" href="https://a.amap.com/jsapi_demos/static/demo-center/css/demo-center.css">
    <link rel="icon" type="image/x-icon" href="geek.ico">
    <script type="text/javascript">
        window._AMapSecurityConfig = {
          securityJsCode: "f6b242cd04daebb47685da20c645bd53",
        };
      </script>
    <script src="https://webapi.amap.com/maps?v=2.0&key=c3f65892c3589481fd26d92b375055e0"></script>
    <script src='https://a.amap.com/jsapi_demos/static/citys.js'></script>
    <style>
        html,
        body,
        #container {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
        }
    </style>
</head>
<body>
<div id="container"></div>
<div class="input-card" style="width: auto;">
    <div class="input-item">
        <button class="btn" onclick="layerGroup.hide()">Hide</button>
    </div>
    <div class="input-item">
        <button class="btn" onclick="layerGroup.show()">Show</button>
    </div>
    <div class="input-item">
        <button class="btn" onclick="layerGroup.setOptions({ opacity: Math.random() })">Transparency</button>
    </div>
    <div class="input-item">
        <button class="btn" onclick="layerGroup.reload()">Reload</button>
    </div>
    <div class="input-item">
        <form action="/map" method="get">
            <button class="btn">Back</button>
        </form>
    </div>
    
</div>
<script language="javascript">
    var map = new AMap.Map('container', {
        center: [116.40, 39.91],
        zoom: 13
    });

    var trafficLayer = new AMap.TileLayer.Traffic({
        zIndex: 11
    });

    var roadNetLayer = new AMap.TileLayer.RoadNet({
        zIndex: 10
    });


    var layerGroup = new AMap.LayerGroup([trafficLayer, roadNetLayer]);
    layerGroup.setMap(map);
</script>
</body>
</html>