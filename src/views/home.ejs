<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compitable" content="IE=edge">
    <!-- <meta http-equiv="refresh" content="1" > -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- <link rel="/stylesheet" href="style.css"> -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;600&display=swap">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <link rel="icon" type="image/x-icon" href="geek.ico">
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
    <title>Home</title>
    <style>
        * {
            font-family: 'Poppins', sans-serif;
        }
        body{
            font-family: 'Poppins', sans-serif;
            background: url('/Mode3.jpg') no-repeat;
            background-size: 120pc;
        }
        /* .background {
            background: url('/Mode3.jpg');
            background-position: bottom;
            background-repeat: no-repeat;
            background-size: cover; 
            height: 91vh;
        } */
        /* .blur {
            background: rgba(255, 255, 255, 0.2); 
            background-size: auto;
            backdrop-filter: blur(1px);
            height: 91vh;   
        } */
        .wrapper{
            text-align: center;
        }
        .wrapper h1{
            font-size: 70px;
            margin-top: 10px;
        }   
        .wrapper .btn{
            /* position: relative;
            top: 150px;
            right: 250px; */
            font-size: 23px;
            border-radius: 25px;
            border-width: 5px;
            border-color: black;
            margin-top: 10px;
        }
        .btn:hover{
            background-color: grey;
            color: white;
        }
        .btnLabel {
            font-family: Arial, Helvetica, sans-serif;
            /* text-align: start; */
            margin-right: 80px;
            position: relative;
            left: 200px;
            font-weight: bold;
        }

        .wrapper .atn{
            position: relative;
            top: 150px;
            display: inline;
            width: 30%;
            border-width: 2px;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 60;
            transition-duration: 0.4s;
        }
        .atn:hover {
            background-color: black;
            color: white;
        }
        span {
            display: inline-block;
            text-align: left;
        }
        td {
            width: 40em;
        }
        table {
            margin-left: 450px;
        }


    </style>

</head>
<body>

    
    <div class="background">
        <div class="blur">
            <div class="wrapper">
                <h1>Home</h1>
                <div class="">
                    <form action="/StudyMode">
                        <button type="submit" class="btn" style="margin-right: 500px"><b>StudyMode</b></button>
                        <br>
                        <br>
                        <table>
                            <tr>
                                <td>
                                    <span class="btnLabel">Studymode is mainly focus on the day of studying. It provides a routine from your location to destination. According to your choice, the route will recommend different passing store to you like library, education, etc ...</span>
                                </td>
                            </tr>
                        </table>
                    </form>
                        <form action="/CausalMode">
                        <button type="submit" class="btn" style="margin-right: 490px"><b>CausalMode</b></button>
                        <br>
                        <br>
                        <table>
                            <tr>
                                <td>
                                    <span class="btnLabel">Causalmode is mainly focus on the day of relaxing. It provides a routine from your location to destination. According to your choice, the route will recommend different passing store to you like gym, park, KTV, etc ...</span>
                                </td>
                            </tr>
                        </table>
                    </form>
                </div>
        
                <div>
                    <form action="/sample_data">
                        <button type="submit" class="atn">History</button>
                    </form>
                    <br>
                    <form action="/Favourite">
                        <button type="submit" class="atn">Favourite</button>
                    </form>
                    <br>
                    <form action="/Recommendation">
                        <button type="submit" class="atn">Recommendation</button>
                    </form>
                    <br>
                    <form action="/travellinghistory">
                        <button type="submit" class="atn">Traveling History</button>
                    </form>
                    <br>
                    <form action="/login">
                        <button type="submit" class="atn">Log out</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js" integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy" crossorigin="anonymous"></script>
    
</body>
</html>